BEGIN
    LTEXT           "About Flicksy\n\nFlicksy lets you send text and key input to a Windows PC\nand run registered actions from your smartphone.\n",IDC_STATIC,31,115,265,39
    LTEXT           "---",IDC_STATIC,31,101,258,11
    GROUPBOX        "",IDC_STATIC,16,46,317,121
